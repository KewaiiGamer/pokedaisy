---
// The hero handhelds' game screen: an overworld of our own (no game art, invented creatures from creatures.js)
// under the app's STATUS BAR, with a text box that types [lines] one after another. Shared by HeroDevice
// (two screens) and HeroSingleDevice (one), inside their `.topscreen`.
import Pixel from './Pixel.astro';
import { spriteUrl } from '../lib/pixel.js';

interface Props { lines: string[] }
const { lines } = Astro.props;
const bg = `--hill:${spriteUrl('hill')};--tuft:${spriteUrl('tuft')};--path:${spriteUrl('path')};--fence:${spriteUrl('fence')};--tall:${spriteUrl('tallgrass')}`;
const daisies = [[4, 66], [24, 69], [60, 64], [74, 72], [90, 66], [40, 90], [56, 93], [92, 92], [8, 93], [31, 63]];
---
<div class="scene" style={bg}>
  <div class="sky"></div>
  <span class="cloud c1"><Pixel name="cloud" scale={1} /></span>
  <span class="cloud c2"><Pixel name="cloud" scale={1.334} /></span>
  <span class="cloud c3"><Pixel name="cloud" scale={0.667} /></span>
  <span class="bird bird-1"><Pixel name="bird" scale={1} /></span>
  <span class="bird bird-2"><Pixel name="bird" scale={0.667} /></span>
  <div class="hills"></div>
  <div class="ground"></div>
  <div class="path"></div>
  <div class="fence"></div>
  <div class="tall"></div>
  <span class="house"><Pixel name="house" scale={1.334} /></span>
  <span class="sign"><Pixel name="sign" scale={1} /></span>
  <span class="pond"><Pixel name="pond" scale={1.334} /></span>
  <span class="tree t1"><Pixel name="tree" scale={1.334} /></span>
  <span class="tree t2"><Pixel name="tree" scale={1.334} /></span>
  <span class="tree t3"><Pixel name="tree" scale={1} /></span>
  {daisies.map(([x, y], i) => <span class="flower" style={`left:${x}%;top:${y}%;animation-delay:-${(i % 3) * 0.4}s`}><Pixel name="daisy" scale={0.667} /></span>)}
  <span class="peek"><Pixel name="sproutling" scale={0.5} /></span>
  <span class="walker"><span class="buddy"><Pixel name="emberpup" scale={0.5} /></span><span class="walker-bob"><Pixel name="walker" scale={1} /></span></span>
  <div class="statusbar">
    <span>DAISY QUEST</span><span class="sb-place"><Pixel name="pin" scale={0.667} />MEADOW PATH</span><span class="sb-right">12:45 · 96%<Pixel name="battery" scale={0.667} /></span>
  </div>
  <div class="textbox f-dialog" data-textbox data-lines={JSON.stringify(lines)}>
    <p data-line>{lines[0]}</p>
    <span class="tb-more"><Pixel name="more" scale={0.667} /></span>
  </div>
</div>

<style is:global>
  /* The screen's text grows with the handheld (6 units, the page's smallest size at most) so a phone's small
     screen isn't all status bar and text box. */
  .handheld .scene { position: absolute; inset: 0; --hh-text: clamp(9px, calc(var(--u) * 6), var(--t-xs)); }
  .handheld .topscreen { overflow: hidden; background: #8ccaf4; }
  .handheld .sky { position: absolute; inset: 0; background: linear-gradient(#7cc0f0 0 18%, #90ccf4 18% 30%, #a6d8f8 30% 40%, #bce2f8 40% 50%, #d0ecfa 50% 60%); }
  .handheld .cloud { position: absolute; left: 0; animation: cloud 40s steps(160) infinite; }
  .handheld .c1 { top: 15%; }
  .handheld .c2 { top: 25%; animation-duration: 56s; animation-delay: -20s; }
  .handheld .c3 { top: 11%; animation-duration: 70s; animation-delay: -45s; opacity: 0.85; }
  @keyframes cloud { from { transform: translateX(-120px); } to { transform: translateX(620px); } }
  .handheld .bird { position: absolute; left: 0; animation: fly 18s steps(90) infinite, flap 0.5s steps(1) infinite; }
  .handheld .bird-1 { top: 20%; }
  .handheld .bird-2 { top: 27%; animation-delay: -6s, -0.25s; }
  @keyframes fly { from { transform: translateX(620px); } to { transform: translateX(-60px); } }
  @keyframes flap { 50% { transform: scaleY(0.4); } }
  .handheld .hills { position: absolute; left: 0; right: 0; top: 46%; height: calc(var(--px) * 14); background: var(--hill) repeat-x 0 0 / calc(var(--px) * 64) 100%; }
  .handheld .ground { position: absolute; left: 0; right: 0; top: calc(46% + var(--px) * 14); bottom: 0; background: #88d058 var(--tuft) repeat 0 0 / calc(var(--px) * 32) calc(var(--px) * 32); }
  .handheld .path { position: absolute; left: 0; right: 0; top: 77%; height: calc(var(--px) * 14); background: var(--path) repeat 0 0 / calc(var(--px) * 32) calc(var(--px) * 16); box-shadow: 0 calc(var(--px) * -1) 0 #6cb848, 0 var(--px) 0 #6cb848; }
  .handheld .fence { position: absolute; left: 30%; width: 26%; top: 60%; height: calc(var(--px) * 8); background: var(--fence) repeat-x 0 0 / calc(var(--px) * 8) 100%; }
  .handheld .tall { position: absolute; left: 36%; width: 20%; top: 66%; height: calc(var(--px) * 16); background: var(--tall) repeat 0 0 / calc(var(--px) * 8) calc(var(--px) * 8); animation: rustle 1.6s steps(1) infinite; }
  @keyframes rustle { 50% { background-position: var(--px) 0; } }
  .handheld .house { position: absolute; left: 7%; top: 36%; }
  .handheld .sign { position: absolute; left: 25%; top: 61%; }
  .handheld .pond { position: absolute; left: 62%; top: 62%; }
  .handheld .tree { position: absolute; }
  .handheld .t1 { left: 80%; top: 37%; }
  .handheld .t2 { left: 0; top: 52%; }
  .handheld .t3 { left: 90%; top: 49%; }
  .handheld .flower { position: absolute; animation: sway 1.2s steps(1) infinite; transform-origin: 50% 100%; }
  @keyframes sway { 50% { transform: rotate(-12deg); } }
  .handheld .walker { position: absolute; top: 70%; left: 0; animation: walk 14s steps(56) infinite alternate; }
  .handheld .walker-bob { display: block; animation: step 0.3s steps(1) infinite; }
  /* An invented creature (creatures.js) trotting beside the trainer, another peeking out of the tall grass. */
  .handheld .walker { display: flex; align-items: flex-end; gap: calc(var(--px) * 2); }
  .handheld .buddy { display: block; animation: step 0.3s steps(1) infinite reverse; }
  .handheld .peek { position: absolute; left: 44%; top: 62%; animation: peek 5s steps(1) infinite; }
  @keyframes peek { 0%, 55%, 100% { transform: translateY(calc(var(--px) * 6)); opacity: 0; } 60%, 90% { transform: none; opacity: 1; } }
  @keyframes walk { from { transform: translateX(80px); } to { transform: translateX(380px); } }
  @keyframes step { 50% { transform: translateY(calc(var(--px) * -1)); } }
  .handheld .statusbar {
    position: absolute; left: 0; right: 0; top: 0; display: flex; gap: calc(var(--u) * 4); align-items: center; padding: var(--u) calc(var(--u) * 3);
    font-size: var(--hh-text); line-height: 1; color: #636363; background: #fff; box-shadow: 0 calc(var(--u) * 0.75) 0 #ced6d6, 0 calc(var(--u) * 1.5) 0 #63737b; white-space: nowrap;
  }
  .handheld .sb-place { color: #cb0707; }
  .handheld .sb-right { margin-left: auto; }
  .handheld .textbox { position: absolute; left: 3%; right: 3%; bottom: 4%; padding: calc(var(--u) * 0.75) calc(var(--u) * 3) calc(var(--u) * 1.5); font-size: var(--hh-text); line-height: 1.5; color: #404048; text-shadow: calc(var(--u) * 0.75) calc(var(--u) * 0.75) 0 #d8d8d0; min-height: 2.4em; }
  .handheld .textbox.closed { visibility: hidden; }
  .handheld .tb-more { position: absolute; right: 6px; bottom: 2px; animation: bob 0.8s steps(1) infinite; }

  .handheld .sb-place, .handheld .sb-right { display: inline-flex; align-items: center; gap: 5px; }
  .handheld .sb-right .pixel { margin-left: 2px; }

  @media (max-width: 560px) { .handheld .sb-right { display: none; } }
</style>

<script>
  // The game screen's text box types a line, waits, closes for a while (the scene shows), then the next.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const box of document.querySelectorAll<HTMLElement>('[data-textbox]')) {
    if (reduce || box.closest('.still')) continue;
    const line = box.querySelector<HTMLElement>('[data-line]')!;
    const LINES: string[] = JSON.parse(box.dataset.lines!);
    let n = 0;
    const next = () => {
      const text = LINES[n++ % LINES.length];
      let i = 0;
      const type = () => {
        line.textContent = text.slice(0, ++i);
        if (i < text.length) setTimeout(type, 34);
        else setTimeout(() => {
          box.classList.add('closed');
          setTimeout(() => { box.classList.remove('closed'); next(); }, 3600);
        }, 2600);
      };
      type();
    };
    setTimeout(next, 2400);
  }
</script>
