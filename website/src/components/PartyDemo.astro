---
// The PARTY tab on its own (PartyPanes), playing itself: the cursor walks the party, opens the first,
// steps DOWN to the next, goes back.
import AppScreen from './AppScreen.astro';
import PartyPanes from './PartyPanes.astro';
---
<div class="party-demo" data-party-demo>
  <AppScreen label="The companion's PARTY tab: six party slots with HP, then one's summary with its moves and weaknesses">
    <PartyPanes />
  </AppScreen>
</div>


<script>
  import { demo } from '../lib/demo.js';

  for (const root of document.querySelectorAll<HTMLElement>('[data-party-demo]')) {
    const slots = [...root.querySelectorAll<HTMLElement>('[data-slot]')];
    const cursor = (i: number) => slots.forEach((s, j) => s.classList.toggle('sel', i === j));
    demo(root, async (d) => {
      d.show('grid');
      cursor(0);
      await d.wait(1100);
      for (const i of [1, 2, 4, 2, 0]) {
        cursor(i);
        await d.wait(650);
      }
      await d.tap('[data-slot="0"]');
      d.show('first');
      await d.wait(2600);
      await d.tap('[data-b="down0"]');
      d.show('second');
      await d.wait(2600);
      await d.tap('[data-b="back1"]');
    });
  }
</script>
